% =====================================================================
%  Bibliography for "Attribution Limits of AI Pentest Agents".
%
%  Scope rule: only sources that this study actually used are cited.
%  - the public internet background-traffic corpus (signature validation)
%  - the ModSecurity / OWASP Core Rule Set deployment that produced the
%    30-day WAF audit log (signature validation and negative population)
%  - the artefact repository itself
%
%  The 65 audited AI pentest frameworks are deliberately NOT listed here:
%  we did not read a published paper for each of them, so inventing
%  bibliographic entries for them would be unsound.  Each framework is
%  cited by its upstream repository URL in the NOTICE file of the artefact
%  repository, with per-signature provenance (repository, file path, line
%  number) in the "framework" and "source" fields of signatures/rules.json.
% =====================================================================

@misc{aasrepo,
  author       = {{The ai-agent-attack-signatures contributors}},
  title        = {{ai-agent-attack-signatures}: traffic signatures and detection
                  methodology for {AI}-powered penetration-testing agents},
  year         = {2026},
  howpublished = {\url{https://github.com/Raven-Gt/ai-agent-attack-signatures}},
  note         = {Artefact repository for the present paper: the tiered signature
                  set, the captured datasets and the evaluation code. Every number
                  reported in the paper is asserted by continuous integration
